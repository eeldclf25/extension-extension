{
  "name": "extension-extension",
  "displayName": "Extension Extension",
  "description": "The extension that makes extensions better.",
  "version": "0.0.2",
  "icon": "icons/two-gears.png",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extext.openDailyCalendar",
        "title": "Open Daily Calendar"
      },
      {
        "command": "extext.createDailyNote",
        "title": "Create Daily Note"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extext-extensionNavigation",
          "title": "Extension Navigation",
          "icon": "icons/calendar.svg"
        }
      ]
    },
    "views": {
      "extext-extensionNavigation": [
        {
          "id": "extext.extensionNavigation",
          "name": "Extension Navigation",
          "icon": "icons/two-gears.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "extext.extensionNavigation",
        "contents": "[(markwhen)데일리 캘린더 열기](command:extext.openDailyCalendar)\n[(Foam)데일리 노트 만들기](command:extext.createDailyNote)\n"
      }
    ],
    "configuration": {
      "title": "Extension Extension",
      "properties": {
        "extext.dailyNotesDirectory": {
          "type": "string",
          "default": "",
          "description": "The path to the folder containing daily notes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}